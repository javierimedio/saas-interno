# Copia este archivo a .env.local y rellena con los valores de tu proyecto Supabase.
# - Local (con Docker): npx supabase start, después npx supabase status para ver los valores.
# - Nube: panel de tu proyecto en supabase.com > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
